<% layout("/layouts/boilerplate") %>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    const title = <%- JSON.stringify(listing.title) %>;
</script>

<style>
    .map-section {
        max-width: 900px;
        margin: 50px auto;
        padding: 0 15px;
    }

    .map-section h3 {
        font-weight: 600;
        margin-bottom: 15px;
    }

    #map {
        width: 100%;
        height: 400px;
        border-radius: 20px;
        overflow: hidden;
        margin-top: 15px;
        margin-bottom: 40px;
        border: 1px solid #e9ecef;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }

    @media (max-width: 768px) {
        #map {
            height: 320px;
            border-radius: 15px;
        }

        .map-section {
            margin-top: 35px;
        }
    }
</style>

<div class="show-page container mt-4 mb-5">

    <!-- Listing Title -->
    <div class="mb-4">
        <h2 class="show-title mb-2">
            <%= listing.title %>
        </h2>

        <p class="text-muted mb-0">
            Hosted by <strong><%= listing.owner.username %></strong>
        </p>
    </div>


    <!-- Listing Image -->
    <div class="show-image-box mb-4">
        <img
            src="<%= listing.image.url %>"
            alt="<%= listing.title %>"
            class="show-image"
        >
    </div>


    <!-- Listing Details -->
    <div class="show-details">

        <p class="show-description">
            <%= listing.description %>
        </p>

        <hr>

        <div class="row text-center">

            <div class="col-md-4 mb-3">
                <h5>💰 Price</h5>
                <p class="text-muted mb-0">
                    &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                </p>
            </div>

            <div class="col-md-4 mb-3">
                <h5>📍 Location</h5>
                <p class="text-muted mb-0">
                    <%= listing.location %>
                </p>
            </div>

            <div class="col-md-4 mb-3">
                <h5>🌍 Country</h5>
                <p class="text-muted mb-0">
                    <%= listing.country %>
                </p>
            </div>

        </div>

    </div>


    <!-- Owner Actions -->
    <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>

        <div class="show-btns mt-4 mb-5">

            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-warning me-2"
            >
                ✏️ Edit Listing
            </a>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
                class="d-inline"
            >
                <button class="btn btn-danger">
                    🗑 Delete Listing
                </button>
            </form>

        </div>

    <% } %>


    <!-- Reviews Section -->
    <div class="reviews-section mt-5">

        <!-- Add Review -->
        <% if (currUser) { %>

            <div class="review-form-card card border-0 shadow-sm rounded-4 mb-5">

                <div class="card-body p-4">

                    <h3 class="mb-4">
                        ⭐ Leave a Review
                    </h3>

                    <form
                        action="/listings/<%= listing._id %>/review"
                        method="POST"
                        class="needs-validation"
                        novalidate
                    >

                        <!-- Rating -->
                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Rating
                            </label>

                            <fieldset class="starability-slot">

                                <input
                                    type="radio"
                                    id="no-rate"
                                    class="input-no-rate"
                                    name="review[rating]"
                                    value="0"
                                    checked
                                    aria-label="No rating."
                                />

                                <input
                                    type="radio"
                                    id="first-rate1"
                                    name="review[rating]"
                                    value="1"
                                />
                                <label
                                    for="first-rate1"
                                    title="Terrible"
                                >
                                    1 star
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate2"
                                    name="review[rating]"
                                    value="2"
                                />
                                <label
                                    for="first-rate2"
                                    title="Not good"
                                >
                                    2 stars
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate3"
                                    name="review[rating]"
                                    value="3"
                                />
                                <label
                                    for="first-rate3"
                                    title="Average"
                                >
                                    3 stars
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate4"
                                    name="review[rating]"
                                    value="4"
                                />
                                <label
                                    for="first-rate4"
                                    title="Very good"
                                >
                                    4 stars
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate5"
                                    name="review[rating]"
                                    value="5"
                                />
                                <label
                                    for="first-rate5"
                                    title="Amazing"
                                >
                                    5 stars
                                </label>

                            </fieldset>

                            <div class="invalid-feedback">
                                Please select a rating.
                            </div>

                        </div>


                        <!-- Comment -->
                        <div class="mb-4">

                            <label
                                for="comment"
                                class="form-label fw-bold"
                            >
                                Comment
                            </label>

                            <textarea
                                class="form-control"
                                id="comment"
                                name="review[comment]"
                                rows="5"
                                placeholder="Share your experience..."
                                required
                            ></textarea>

                            <div class="invalid-feedback">
                                Please write your review.
                            </div>

                        </div>


                        <!-- Submit -->
                        <button
                            type="submit"
                            class="btn btn-dark px-4"
                        >
                            Submit Review
                        </button>

                    </form>

                </div>

            </div>

        <% } %>


        <!-- All Reviews -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="mb-0">
                💬 All Reviews
            </h3>

            <% if (listing.reviews.length > 0) { %>
                <span class="badge bg-secondary rounded-pill">
                    <%= listing.reviews.length %>
                    <%= listing.reviews.length === 1 ? "Review" : "Reviews" %>
                </span>
            <% } %>

        </div>


        <!-- No Reviews -->
        <% if (listing.reviews.length === 0) { %>

            <div class="alert alert-secondary rounded-4 text-center py-4">

                <h5 class="mb-2">
                    No reviews yet
                </h5>

                <p class="mb-0 text-muted">
                    Be the first person to review this listing!
                </p>

            </div>

        <% } else { %>


            <!-- Reviews Grid -->
            <div class="row">

                <% for (let review of listing.reviews) { %>

                    <div class="col-lg-6 mb-4">

                        <div class="card shadow-sm h-100 border-0 rounded-4">

                            <div class="card-body p-4">

                                <!-- Review Header -->
                                <div class="d-flex justify-content-between align-items-start">

                                    <div>

                                        <h5 class="mb-2">
                                            👤 <%= review.author.username %>
                                        </h5>

                                        <p
                                            class="starability-result mb-3"
                                            data-rating="<%= review.rating %>"
                                        >
                                        </p>

                                    </div>


                                    <!-- Delete Review -->
                                    <% if (
                                        currUser &&
                                        review.author &&
                                        currUser._id.equals(review.author._id)
                                    ) { %>

                                        <form
                                            method="POST"
                                            action="/listings/<%= listing._id %>/review/<%= review._id %>?_method=DELETE"
                                        >
                                            <button
                                                type="submit"
                                                class="btn btn-outline-danger btn-sm rounded-pill"
                                            >
                                                🗑 Delete
                                            </button>
                                        </form>

                                    <% } %>

                                </div>


                                <!-- Review Comment -->
                                <p class="card-text text-muted mb-0">
                                    <%= review.comment %>
                                </p>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>

        <% } %>

    </div>
</div>

 <div class="map-section">
        <h3>📍 Where You'll be</h3>
        <div id="map">

        </div>
 </div>


<script src="/javascript/map.js"></script>